# AppFolio MCP Server: environment configuration.
# Each API's tools only need their own credentials; the other set's tools
# error at call time if their vars are unset. Configure one or both.

# -- Reporting API v2 (required for list_reports / describe_report / run_report) --

# Required (Reporting API): your AppFolio database name, the subdomain in {vhost}.appfolio.com
APPFOLIO_VHOST=yourcompany
# Required (Reporting API): Reports API Client ID (Account Settings > Manage API Settings > Reports API Credentials)
APPFOLIO_CLIENT_ID=your-reports-client-id
# Required (Reporting API): Reports API Client Secret
APPFOLIO_CLIENT_SECRET=your-reports-client-secret

# -- Database API v0 (required for list_endpoints / describe_endpoint / call_endpoint) --

# Required (Database API): your AppFolio Developer ID (Admin > Developer ID)
APPFOLIO_DB_DEVELOPER_ID=your-developer-id
# Required (Database API): Basic Auth Client ID (API Credentials > Basic Auth)
APPFOLIO_DB_CLIENT_ID=your-db-client-id
# Required (Database API): Basic Auth Client Secret
APPFOLIO_DB_CLIENT_SECRET=your-db-client-secret
