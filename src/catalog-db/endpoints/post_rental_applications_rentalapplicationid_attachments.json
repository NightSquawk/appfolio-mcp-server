    }
  ],
  "requestBody": {
    "required": true,
    "description": "Attachment object",
    "attributes": [
      {
        "name": "File",
        "type": "string",
        "required": false,
        "description": "Filename.file-extension",
        "format": "multipart/form-data"
      }
    ]
  },
  "responseFields": [
    {
      "name": "Id",
      "type": "string <uuid>",
