{
  "operationId": "post_occupancies_occupancyid_attachments",
  "resource": "occupancies",
  "name": "Create Occupancy Attachment",
  "method": "POST",
  "path": "/occupancies/{OccupancyId}/attachments",
  "description": "Add an attachment to an occupancy",
  "deprecated": false,
  "writeOperation": true,
  "pagination": false,
  "pathParams": [
    {
      "name": "OccupancyId",
      "type": "string <uuid>",
      "required": true,
      "description": "The occupancy to which the file will be attached"
    }
  ],
  "requestBody": {
    "required": true,
    "description": "Attachment object",
    "attributes": [
      {
        "name": "File",
        "type": "string",
        "required": false,
        "description": "Filename.file-extension",
        "format": "multipart/form-data"
      }
    ]
  },
  "responseFields": [
    {
      "name": "Id",
      "type": "string <uuid>",
      "required": false,
      "description": "Unique identifier of the occupancy attachment"
    }
  ],
  "requestSample": "{\n  \"File\": \"/path/to/file.pdf\"\n}"
}
