        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "sent_at_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Sent At From' date to filter by."
    },
    {
      "name": "sent_at_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Sent At To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
