{
  "slug": "receivables_activity",
  "endpoint": "receivables_activity.json",
  "name": "Receivables Activity",
  "description": "Returns Receivables Activity report data.",
  "requiredFilters": [
    "receipt_date_from",
    "receipt_date_to"
  ],
  "parameters": [
    {
      "name": "tenant_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": ""
    },
    {
      "name": "tenant_statuses",
      "type": "array",
      "required": false,
      "default": [
        "0",
        "4"
      ],
      "enum": [
        "'2' denotes 'Future'",
        "'0' denotes 'Current'",
        "'4' denotes 'Notice'",
        "'1' denotes 'Past'",
        "'3' denotes 'Evict'"
      ],
      "description": "List of Tenant status to filter by."
    },
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "receipt_date_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Receipt Date From' date to filter by."
    },
    {
      "name": "receipt_date_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Receipt Date To' date to filter by."
    },
    {
      "name": "manually_entered_only",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Show Manually Entered Receipts Only"
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "tenant_visibility": "active",
    "tenant_statuses": [
      "0",
      "4"
    ],
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "receipt_date_from": "2023-06-01",
    "receipt_date_to": "2023-06-30",
    "manually_entered_only": "1",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
