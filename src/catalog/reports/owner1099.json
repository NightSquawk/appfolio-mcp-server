    },
    "year": "2023",
    "show_eligible_1099_owners": "1",
    "balance_operator": {
      "amount": "100",
      "comparator": "="
    },
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
