{
  "slug": "owner1099",
  "endpoint": "owner1099.json",
  "name": "Owner 1099 Summary",
  "description": "Returns Owner 1099 Summary report data.",
  "requiredFilters": [
    "year"
  ],
  "parameters": [
    {
