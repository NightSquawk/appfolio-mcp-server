        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "tenant_statuses",
      "type": "array",
      "required": false,
      "default": "[\"0\"]",
      "enum": [
        "'2' denotes 'Future'",
        "'0' denotes 'Current'",
        "'4' denotes 'Notice'",
        "'1' denotes 'Past'"
      ],
      "description": "List of Homeowner status to filter by."
    },
    {
      "name": "homeowner_visibility",
      "type": "string",
      "required": false,
