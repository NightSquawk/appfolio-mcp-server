{
  "slug": "tenant_unpaid_charges_summary",
  "endpoint": "tenant_unpaid_charges_summary.json",
  "name": "Tenant Unpaid Charges Summary",
  "description": "Returns Tenant Unpaid Charges Summary report data.",
  "requiredFilters": [
    "occurred_on_to",
    "balance_operator"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "tenant_statuses",
      "type": "array",
      "required": false,
      "default": "[\"0\",\"4\"]",
      "enum": [
        "'2' denotes 'Future'",
        "'0' denotes 'Current'",
        "'4' denotes 'Notice'",
        "'1' denotes 'Past'",
        "'3' denotes 'Evict'"
      ],
      "description": "List of Tenant status to filter by."
    },
    {
      "name": "occurred_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'As of To' date to filter by."
    },
    {
      "name": "balance_operator",
      "type": "object",
      "required": true,
      "description": "The Balance to filter by. Expand to view all attributes associated with this filter.",
      "attributes": [
        {
          "name": "amount",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "comparator",
          "type": "string",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "tenant_statuses": [
      "0",
      "4"
    ],
    "occurred_on_to": "2023-06-30",
    "balance_operator": {
      "amount": "100",
      "comparator": "="
    },
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": [
    "property",
    "property_name",
    "property_id",
    "property_address",
    "property_street",
    "property_street2",
    "property_city",
    "property_state",
    "property_zip",
    "unit",
    "name",
    "tenant_status",
    "tenant_id",
    "account",
    "account_name",
    "account_number",
    "total",
    "amount_receivable",
    "unit_id",
    "occupancy_id"
  ]
}