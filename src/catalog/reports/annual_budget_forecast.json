{
  "slug": "annual_budget_forecast",
  "endpoint": "annual_budget_forecast.json",
  "name": "Annual Budget - Forecast",
  "description": "Returns Annual Budget - Forecast report data.",
  "requiredFilters": [
    "period_from",
    "period_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "period_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM",
      "description": "The 'Period From' month to filter by."
    },
    {
      "name": "period_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM",
      "description": "The 'Period To' month to filter by."
    },
    {
      "name": "consolidate",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Consolidate"
    },
    {
      "name": "accounting_basis",
      "type": "string",
      "required": false,
      "default": "Cash",
      "enum": [
        "Cash",
        "Accrual"
      ],
      "description": "The accounting basis to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "period_from": "2023-06",
    "period_to": "2023-06",
    "consolidate": "1",
    "accounting_basis": "Cash",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": [
    "account_name",
    "account_code",
    "months",
    "total",
    "property_name",
    "property_id",
    "account_id",
    "note"
  ]
}
