{
  "slug": "violation_detail",
  "endpoint": "violation_detail.json",
  "name": "Violation Detail",
  "description": "Returns Violation Detail report data.",
  "requiredFilters": [
    "noted_on_from",
    "noted_on_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "homeowner_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": ""
    },
    {
      "name": "noted_on_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Date From' date to filter by."
    },
    {
      "name": "noted_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Date To' date to filter by."
    },
    {
      "name": "violation_statuses",
      "type": "array",
      "required": false,
      "default": "[\"0\",\"1\"]",
      "enum": [
        "'0' denotes 'In Progress'",
        "'1' denotes 'In Dispute'",
        "'2' denotes 'Corrected'",
        "'3' denotes 'On Hold'"
      ],
      "description": "Violation Status to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "homeowner_visibility": "active",
    "noted_on_from": "2023-06-01",
    "noted_on_to": "2023-06-30",
    "violation_statuses": [
      "1",
      "2"
    ],
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
