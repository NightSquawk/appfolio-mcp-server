{
  "slug": "work_order_labor_summary",
  "endpoint": "work_order_labor_summary.json",
  "name": "Work Order Labor Summary",
  "description": "Returns Work Order Labor Summary report data.",
  "requiredFilters": [
    "labor_performed_from",
    "labor_performed_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "maintenance_tech",
      "type": "string",
      "required": false,
      "default": "All",
      "description": "Maintenance tech id to filter by."
    },
    {
      "name": "work_order_statuses",
      "type": "array",
      "required": false,
      "default": [
        "0",
        "1",
        "2",
        "9",
        "3",
        "6",
        "8",
        "12",
        "4",
        "5",
        "7"
      ],
      "enum": [
        "'0' denotes 'New'",
        "'1' denotes 'Estimate Requested'",
        "'2' denotes 'Estimated'",
        "'9' denotes 'Assigned'",
        "'3' denotes 'Scheduled'",
        "'6' denotes 'Waiting'",
        "'8' denotes 'Work Done'",
        "'12' denotes 'Ready to Bill'",
        "'4' denotes 'Completed'",
        "'5' denotes 'Canceled'",
        "'7' denotes 'Completed No Need To Bill'"
      ],
      "description": "Current Work Order Status to filter by."
    },
    {
      "name": "unit_turn",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Unit Turn Work Orders only"
    },
    {
      "name": "labor_performed_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'From' date to filter by."
    },
    {
      "name": "labor_performed_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "maintenance_tech": "All",
    "work_order_statuses": [
      "1",
      "2"
    ],
    "unit_turn": "1",
    "labor_performed_from": "2023-06-01",
    "labor_performed_to": "2023-06-30",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
