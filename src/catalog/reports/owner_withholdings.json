          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "party_contact_info",
      "type": "object",
      "required": false,
      "description": "The Owner filter. Expand to view all attributes associated with this filter. You can only submit ONE of the below filters.",
