{
  "slug": "charge_detail",
  "endpoint": "charge_detail.json",
  "name": "Charge Detail",
  "description": "Returns Charge Detail report data.",
  "requiredFilters": [
    "charge_date_from",
    "charge_date_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "parties_ids",
      "type": "object",
      "required": false,
      "description": "The occupancy ids to filter by. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "occupancies_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "tenant_statuses",
      "type": "array",
      "required": false,
      "default": "[\"0\",\"4\"]",
      "enum": [
        "'2' denotes 'Future'",
        "'0' denotes 'Current'",
        "'4' denotes 'Notice'",
        "'1' denotes 'Past'",
        "'3' denotes 'Evict'"
      ],
      "description": "List of Tenant status to filter by."
    },
    {
      "name": "gl_account_ids",
      "type": "array",
      "required": false,
      "default": "[]",
      "description": "The gl account ids to filter by."
    },
    {
      "name": "date_type",
      "type": "string",
      "required": false,
      "default": "Charge Date",
      "enum": [
        "Charge Date",
        "Posting Date"
      ],
      "description": "The Date Type to filter by."
    },
    {
      "name": "payment_status",
      "type": "string",
      "required": false,
      "default": "All",
      "enum": [
        "All",
        "Paid",
        "Unpaid"
      ],
      "description": "The Charge Status to filter by."
    },
    {
      "name": "charge_date_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Charge Date From' date to filter by."
    },
    {
      "name": "charge_date_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Charge Date To' date to filter by."
    },
    {
      "name": "receipt_type",
      "type": "string",
      "required": false,
      "default": "All",
      "enum": [
        "All",
        "Tenant Receipts Only",
        "Other Receipts Only",
        "Owner Receipts Only"
      ],
      "description": "Receipt Type to filter by."
    },
    {
      "name": "receipt_date_from",
      "type": "string",
      "required": false,
      "default": "",
      "format": "YYYY-MM-DD",
      "description": "The 'Receipt Date From' date to filter by."
    },
    {
      "name": "receipt_date_to",
      "type": "string",
      "required": false,
      "default": "",
      "format": "YYYY-MM-DD",
      "description": "The 'Receipt Date To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "parties_ids": {
      "occupancies_ids": []
    },
    "tenant_statuses": [
      "0",
      "4"
    ],
    "gl_account_ids": [
      "1",
      "2"
    ],
    "date_type": "Charge Date",
    "payment_status": "All",
    "charge_date_from": "2023-06-01",
    "charge_date_to": "2023-06-30",
    "receipt_type": [
      "1",
      "2"
    ],
    "receipt_date_from": "2023-06-01",
    "receipt_date_to": "2023-06-30",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
