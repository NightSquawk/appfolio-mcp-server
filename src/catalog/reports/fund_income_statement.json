{
  "slug": "fund_income_statement",
  "endpoint": "fund_income_statement.json",
  "name": "Fund Income Statement",
  "description": "Returns Fund Income Statement report data.",
  "requiredFilters": [
    "occurred_on_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "occurred_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM",
      "description": "The 'As of' month to filter by."
    },
    {
      "name": "accounting_basis",
      "type": "string",
      "required": false,
      "default": "Cash",
      "enum": [
        "Cash",
        "Accrual",
        "Modified Accrual"
      ],
      "description": "The accounting basis to filter by."
    },
    {
      "name": "fund_type",
      "type": "string",
      "required": false,
      "default": "reserve",
      "enum": [
        "operating",
        "reserve"
      ],
      "description": "Fund type to filter by."
    },
    {
      "name": "level_of_detail",
      "type": "string",
      "required": false,
      "default": "detail_view",
      "enum": [
        "detail_view",
        "summary_view"
      ],
      "description": "The level of detail to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "occurred_on_to": "2023-06",
    "accounting_basis": "Cash",
    "fund_type": "operating",
    "level_of_detail": "detail_view",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": [
    "account_name",
    "mtd_actual",
    "mtd_budget",
    "mtd_amount_variance",
    "mtd_percent_variance",
    "ytd_actual",
    "ytd_budget",
    "ytd_amount_variance",
    "ytd_percent_variance",
    "annual",
    "account_number"
  ]
}
