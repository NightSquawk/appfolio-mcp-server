{
  "slug": "occupancy_summary",
  "endpoint": "occupancy_summary.json",
  "name": "Occupancy Summary",
  "description": "Returns Occupancy Summary report data.",
  "requiredFilters": [
    "as_of_to"
  ],
  "parameters": [
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "unit_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": ""
    },
    {
      "name": "as_of_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'As of To' date to filter by."
    },
    {
      "name": "non_revenue_units",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Include Non-Revenue Units"
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "unit_visibility": "active",
    "as_of_to": "2023-06-30",
    "non_revenue_units": "1",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
