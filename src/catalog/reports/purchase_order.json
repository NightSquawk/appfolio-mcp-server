{
  "slug": "purchase_order",
  "endpoint": "purchase_order.json",
  "name": "Purchase Order",
  "description": "Returns Purchase Order report data.",
  "requiredFilters": [
    "created_date_from",
    "created_date_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "unit_ids",
      "type": "array",
      "required": false,
      "description": "Unique reference number of the unit or units to filter by."
    },
    {
      "name": "property",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. You can only submit ONE of the below filters.",
      "attributes": [
        {
          "name": "property_id",
          "type": "string",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "gl_account_ids",
      "type": "array",
      "required": false,
      "default": "[]",
      "description": "The gl account ids to filter by."
    },
    {
      "name": "party_contact_info",
      "type": "object",
      "required": false,
      "description": "The Vendor filter. Expand to view all attributes associated with this filter. You can only submit ONE of the below filters.",
      "attributes": [
        {
          "name": "company_id",
          "type": "string",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "approved",
      "type": "string",
      "required": false,
      "default": "all",
      "enum": [
        "all",
        "Approved",
        "Pending Approval",
        "Exempt",
        "Pending Revision"
      ],
      "description": "Approval status to filter by."
    },
    {
      "name": "received",
      "type": "string",
      "required": false,
      "default": "all",
      "enum": [
        "all",
        "Yes",
        "No"
      ],
      "description": "Received to filter by."
    },
    {
      "name": "completed",
      "type": "string",
      "required": false,
      "default": "all",
      "enum": [
        "all",
        "Completed",
        "Not Completed"
      ],
      "description": "Completed to filter by."
    },
    {
      "name": "canceled",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Show canceled purchase orders"
    },
    {
      "name": "created_date_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'From' date to filter by."
    },
    {
      "name": "created_date_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "unit_ids": [
      "1",
      "2",
      "3"
    ],
    "property": {
      "property_id": "1"
    },
    "gl_account_ids": [
      "1",
      "2"
    ],
    "party_contact_info": {
      "company_id": "1"
    },
    "approved": "all",
    "received": "all",
    "completed": "all",
    "canceled": "1",
    "created_date_from": "2023-06-01",
    "created_date_to": "2023-06-30",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
