{
  "slug": "loans",
  "endpoint": "loans.json",
  "name": "Loans",
  "description": "Returns Loans report data.",
  "requiredFilters": [
    "reference_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "reference_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'As of To' date to filter by."
    },
    {
      "name": "show_hidden_loans",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Show Hidden Loans"
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "reference_to": "2023-06-30",
    "show_hidden_loans": "1",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
