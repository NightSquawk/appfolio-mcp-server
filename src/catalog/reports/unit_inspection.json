{
  "slug": "unit_inspection",
  "endpoint": "unit_inspection.json",
  "name": "Unit Inspection",
  "description": "Returns Unit Inspection report data.",
  "requiredFilters": [
    "last_inspection_on_from"
  ],
  "parameters": [
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "unit_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The unit visibility to filter by."
    },
    {
      "name": "last_inspection_on_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "Filter for all inspection dates on and before this date."
    },
    {
      "name": "include_blank_inspection_date",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Include Units with Blank Inspection Date"
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "unit_visibility": "active",
    "last_inspection_on_from": "2023-06-01",
    "include_blank_inspection_date": "1",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
