{
  "slug": "rental_applications",
  "endpoint": "rental_applications.json",
  "name": "Rental Applications",
  "description": "Returns Rental Applications report data.",
  "requiredFilters": [
    "received_on_from",
    "received_on_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "unit_ids",
      "type": "array",
      "required": false,
      "description": "Unique reference number of the unit or units to filter by."
    },
    {
      "name": "property",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. You can only submit ONE of the below filters.",
      "attributes": [
        {
          "name": "property_id",
          "type": "string",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "rental_application_statuses",
      "type": "array",
      "required": false,
      "default": "[\"all\"]",
      "enum": [
        "all",
        "New",
        "Decision Pending",
        "In Review",
        "Info Needed",
        "In Screening",
        "Approved",
        "Denied",
        "Canceled",
        "Converting",
        "Converted"
      ],
      "description": "Status to filter by."
    },
    {
      "name": "rental_applications_filter_date_range_by",
      "type": "string",
      "required": false,
      "default": "Rental Application Received Date",
      "enum": [
        "Rental Application Received Date",
        "Decision Made Date"
      ],
      "description": "Filter date range by to filter by."
    },
    {
      "name": "received_on_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Date From' date to filter by."
    },
    {
      "name": "received_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Date To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "unit_ids": [
      "1",
      "2",
      "3"
    ],
    "property": {
      "property_id": "1"
    },
    "rental_application_statuses": [
      "New",
      "Decision Pending"
    ],
    "rental_applications_filter_date_range_by": "Rental Application Received Date",
    "received_on_from": "2023-06-01",
    "received_on_to": "2023-06-30",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
