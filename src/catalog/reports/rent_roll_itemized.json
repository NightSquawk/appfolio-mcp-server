{
  "slug": "rent_roll_itemized",
  "endpoint": "rent_roll_itemized.json",
  "name": "Rent Roll (Itemized)",
  "description": "Returns Rent Roll (Itemized) report data.",
  "requiredFilters": [
    "as_of_to"
  ],
  "parameters": [
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "unit_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": ""
    },
    {
      "name": "tags",
      "type": "string",
      "required": false,
      "description": "The comma-separated tag(s) to filter by"
    },
    {
      "name": "include_advertised_rent",
      "type": "string",
      "required": false,
      "default": "1",
      "enum": [
        "0",
        "1"
      ],
      "description": "Include Advertised Rent"
    },
    {
      "name": "gl_account_ids",
      "type": "array",
      "required": false,
      "default": "[]",
      "description": "The gl account ids to filter by. There is a limit of 250 GL Accounts to choose from. Only GL Accounts associated with Recurring Charges are valid."
    },
    {
      "name": "as_of_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'As of To' date to filter by."
    },
    {
      "name": "non_revenue_units",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Include Non-Revenue Units"
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "unit_visibility": "active",
    "tags": "bbq,deck",
    "include_advertised_rent": "1",
    "gl_account_ids": [
      "1",
      "2"
    ],
    "as_of_to": "2023-06-30",
    "non_revenue_units": "1",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
