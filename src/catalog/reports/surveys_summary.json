{
  "slug": "surveys_summary",
  "endpoint": "surveys_summary.json",
  "name": "Survey Responses",
  "description": "Returns Survey Responses report data.",
  "requiredFilters": [
    "occurred_on_from",
    "occurred_on_to"
  ],
  "parameters": [
    {
      "name": "survey_type",
      "type": "string",
      "required": false,
      "default": "maintenance",
      "enum": [
        "maintenance",
        "'move-in' denotes 'Move In'",
        "'move-out' denotes 'Move Out'",
        "showing"
      ],
      "description": "Survey type to filter by."
    },
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "date_type",
      "type": "string",
      "required": false,
      "default": "Date Sent",
      "enum": [
        "Date Sent",
        "Date Received"
      ],
      "description": "The Date Type to filter by."
    },
    {
      "name": "occurred_on_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Date From' date to filter by."
    },
    {
      "name": "occurred_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Date To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "survey_type": "maintenance",
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "date_type": "Date Sent",
    "occurred_on_from": "2023-06-01",
    "occurred_on_to": "2023-06-30",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": []
}
