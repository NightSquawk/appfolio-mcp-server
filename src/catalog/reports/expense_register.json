{
  "slug": "expense_register",
  "endpoint": "expense_register.json",
  "name": "Expense Register",
  "description": "Returns Expense Register report data.",
  "requiredFilters": [
    "occurred_on_from",
    "occurred_on_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "party_contact_info",
      "type": "object",
      "required": false,
      "description": "The Payee filter. Expand to view all attributes associated with this filter. You can only submit ONE of the below filters.",
      "attributes": [
        {
          "name": "company_id",
          "type": "string",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "payment_status",
      "type": "string",
      "required": false,
      "default": "All",
      "enum": [
        "All",
        "Paid",
        "Unpaid"
      ],
      "description": "The Bill Status to filter by."
    },
    {
      "name": "occurred_on_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Bill Date From' date to filter by."
    },
    {
      "name": "occurred_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "The 'Bill Date To' date to filter by."
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "party_contact_info": {
      "company_id": "1"
    },
    "payment_status": "All",
    "occurred_on_from": "2023-06-01",
    "occurred_on_to": "2023-06-30",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": [
    "property",
    "property_name",
    "property_id",
    "property_address",
    "property_street",
    "property_street2",
    "property_city",
    "property_state",
    "property_zip",
    "unit",
    "payee_name",
    "bill_date",
    "check_date",
    "due_date",
    "expense_account",
    "expense_account_name",
    "expense_account_number",
    "cash_account",
    "cash_account_name",
    "cash_account_number",
    "amount",
    "unpaid",
    "reference_number",
    "description",
    "check_amount",
    "unit_id"
  ]
}
