{
  "slug": "twelve_month_cash_flow",
  "endpoint": "twelve_month_cash_flow.json",
  "name": "Cash Flow - 12 Month",
  "description": "Returns Cash Flow - 12 Month report data.",
  "requiredFilters": [
    "posted_on_from",
    "posted_on_to"
  ],
  "parameters": [
    {
      "name": "property_visibility",
      "type": "string",
      "required": false,
      "default": "active",
      "enum": [
        "active",
        "hidden",
        "all"
      ],
      "description": "The property visibility to filter by."
    },
    {
      "name": "properties",
      "type": "object",
      "required": false,
      "description": "The property filter. Expand to view all attributes associated with this filter. If required, you must submit an id for at least one of the below filters.",
      "attributes": [
        {
          "name": "properties_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "property_groups_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "portfolios_ids",
          "type": "array",
          "required": false,
          "description": ""
        },
        {
          "name": "owners_ids",
          "type": "array",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "posted_on_from",
      "type": "string",
      "required": true,
      "format": "YYYY-MM",
      "description": "The 'Period From' month to filter by."
    },
    {
      "name": "posted_on_to",
      "type": "string",
      "required": true,
      "format": "YYYY-MM",
      "description": "The 'Period To' month to filter by."
    },
    {
      "name": "accounting_basis",
      "type": "string",
      "required": false,
      "default": "Cash",
      "enum": [
        "Cash",
        "Accrual",
        "Modified Accrual"
      ],
      "description": "The accounting basis to filter by."
    },
    {
      "name": "gl_account_ids",
      "type": "array",
      "required": false,
      "default": "[]",
      "description": "The gl account ids to filter by."
    },
    {
      "name": "level_of_detail",
      "type": "string",
      "required": false,
      "default": "detail_view",
      "enum": [
        "detail_view",
        "summary_view"
      ],
      "description": "The level of detail to filter by."
    },
    {
      "name": "include_zero_balance_gl_accounts",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Include Zero Balance GL Accounts"
    },
    {
      "name": "exclude_suppressed_fees",
      "type": "string",
      "required": false,
      "default": "0",
      "enum": [
        "0",
        "1"
      ],
      "description": "Exclude Suppressed Fees"
    },
    {
      "name": "columns",
      "type": "array",
      "required": false,
      "description": "Returns the specified columns. All columns are returned by default. Look at the response schema to see the available columns."
    }
  ],
  "requestSample": {
    "property_visibility": "active",
    "properties": {
      "properties_ids": [],
      "property_groups_ids": [],
      "portfolios_ids": [],
      "owners_ids": []
    },
    "posted_on_from": "2023-06",
    "posted_on_to": "2023-06",
    "accounting_basis": "Cash",
    "gl_account_ids": [
      "1",
      "2"
    ],
    "level_of_detail": "detail_view",
    "include_zero_balance_gl_accounts": "1",
    "exclude_suppressed_fees": "1",
    "columns": [
      "some_column",
      "some_other_column"
    ]
  },
  "responseColumns": [
    "account_name",
    "account_code",
    "months",
    "total"
  ]
}
